(def constant ADM_ROW_HEIGHT 15px)
(def constant ADM_ROW_GAP 2px)

(def constant ADM_INCOMING_LOGS_KEY 'modAdvancedDamageMeterIncomingDamage')
(def constant ADM_OUTGOING_LOGS_KEY 'modAdvancedDamageMeterOutgoingDamage')

(def macro ADM_GET_DAMAGELOGS()
	(var __damageLogKey:str = "_isIncomingDamage ? ADM_INCOMING_LOGS_KEY : ADM_OUTGOING_LOGS_KEY")
	(var __damageMeterEntityWatcher:gfx = "$datahub.getPrimWatcher(CC.mods_DataComponent, __damageLogKey)")
	(var __damageMeterEntity:gfx = "__damageMeterEntityWatcher.entity" (event "__damageMeterEntityWatcher.event"))
	(var __dataComponent:gfx = "__damageMeterEntity && __damageMeterEntity.hasComponent(CC.mods_DataComponent) ? __damageMeterEntity.mods_DataComponent : null" (event "__damageMeterEntity.evAdded"))
	(var damageLogs:array = "__dataComponent ? __dataComponent.data.damageLogs : []" (event "__dataComponent.evDataChanged"))
)

(def element ADM_AdvancedDamageMeter() layout=true
	(scope
		(macro STAGE_SIZE)
	)

	(style
		(bind width "stageWidth")
		(bind height "stageHeight")
	)

	(element ADM_DamageMeterItem _isIncomingDamage="true")
	(element ADM_DamageMeterItem _isIncomingDamage="false")
)

(def element ADM_DamageMeterItem(_isIncomingDamage:bool=true)
	(scope
		# Incoming and outgoing are two independent subtrees of the schema, so the dotted key is a
		# per-side PREFIX composed at each call site.  The position hangs off the same prefix as
		# `<prefix>.position` -- a position key is never the prefix itself, or its opaque bucket map
		# would share a node with the siblings and eat them.
		(var sidePref:str = "_isIncomingDamage ? 'ttaro.dDamageMeter.incoming' : 'ttaro.dDamageMeter.outgoing'")

		(macro TT_GET_PREF _varName="'scalePref'" _key="'ttaro.dDamageMeter.scale'")
		(var scale:number = "null != scalePref && null != scalePref.value ? scalePref.value : 1")
		(macro TT_GET_PREF _varName="'rowCountsPref'" _key="'ttaro.dDamageMeter.panel.rowCount'")
		(var rowCounts:number = "null != rowCountsPref && null != rowCountsPref.value ? rowCountsPref.value : 3")
		(macro TT_GET_PREF _varName="'rowGapPref'" _key="'ttaro.dDamageMeter.panel.rowHeight'")
		(var rowGap:number = "null != rowGapPref && null != rowGapPref.value ? rowGapPref.value : 2")
		(macro TT_GET_PREF _varName="'backgroundAlphaPref'" _key="'ttaro.dDamageMeter.background.alpha'")
		(var backgroundAlpha:number = "null != backgroundAlphaPref && null != backgroundAlphaPref.value ? backgroundAlphaPref.value : 0.4")

		(macro TT_GET_PREF _varName="'backgroundDisplayModePref'" _key="'ttaro.dDamageMeter.background.displayMode'")
		(var backgroundDisplayMode:number = "null != backgroundDisplayModePref && null != backgroundDisplayModePref.value ? backgroundDisplayModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")
		(macro TT_GET_PREF _varName="'reverseRowsPref'" _key="'ttaro.dDamageMeter.panel.reverseRows'")
		(var isReversed:bool = "null != reverseRowsPref && null != reverseRowsPref.value ? reverseRowsPref.value : false")
		(macro TT_GET_PREF _varName="'disableDragdropPref'" _key="'ttaro.dDamageMeter.disableDragDrop'")
		(var isPositionLocked:bool = "null != disableDragdropPref && null != disableDragdropPref.value ? disableDragdropPref.value : false")

		(macro ADM_GET_FONT_COLOR)

		# DamageLogEntity
		(macro ADM_GET_DAMAGELOGS)

		# Header Text
		(var headerText:str = "_isIncomingDamage ? 'IDS_TAKEN_DAMAGE_HINT' : 'IDS_BATTLE_STATS_CAUSED_DAMAGE'")

		# Visibility is this side's DISPLAY_MODE alone.  There is deliberately no meter-wide override on
		# top: with one, "alt-only" became the OR of three settings and the config screen stopped
		# explaining what you would actually see.
		(var camera:gfx = "$datahub.getSingleComponent(CC.camera)")
		(var altVision:bool = "camera.altVision" (event "camera.evAltVisionChanged"))
		(macro TT_GET_PREF _varName="'displayModePref'" _key="sidePref + '.displayMode'")
		(var displayMode:number = "null != displayModePref && null != displayModePref.value ? displayModePref.value : TT_CONST.DISPLAY_MODE.ENABLED")
		(var isVisible:bool = "displayMode == TT_CONST.DISPLAY_MODE.DISABLED ? false : (displayMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : true)")

		# Background
		(var isBackgroundVisible:bool = "backgroundDisplayMode == TT_CONST.DISPLAY_MODE.DISABLED ? false : (backgroundDisplayMode == TT_CONST.DISPLAY_MODE.ADAPTIVE ? altVision : true)")

		# Python owns the position value, its resKey bucket AND the first-placement default
		# (the schema's left/bottom anchor, which the pivot below matches), so there is no view-side
		# default or stage math here.
		(macro TT_DRAGGABLE_POSITION _fullKey="sidePref + '.position'")
	)

	(bind visible "isVisible")

	(style
		(position = "absolute")
		(bind left "dragX")
		(bind top "dragY")
		# NO pivot -- top-left origin, as legacy.  A stored position is an ORIGIN, so a pivot change
		# re-reads the folded legacy advancedDamageMeterIncoming/Outgoing_positionY as a bottom edge
		# and moves every migrated panel up by its own height.
		# The schema's left/bottom anchor still resolves correctly without a matching pivot: Python is
		# size-aware and the pivot cancels (boxTop = P - f*size, via the reported poy).  The legacy
		# top-left defaults were stageHeight-110 / stageHeight-220 against schema offsets 10 / 120 --
		# exactly one panel height apart, which is that same size term.
		# Consequence, and it matches legacy: the panel grows DOWNWARD from a fixed top as rowCounts
		# rises, not upward from a fixed bottom.
	)

	# Full-size transparent drag surface, coextensive with the positioned element (reportGeometry
	# describes the block TT_DRAGGABLE sits in, so a smaller grab handle would relocate the panel).
	# Declared BEFORE the content so the injected signifier stays behind it -- zindex does not cross a
	# block boundary.  hitTest follows the lock: the macro gates the drag writes and the signifier,
	# but only dropping hitTest here suppresses the drag-hint tooltip.
	(block
		(class $FullsizeAbsolute)
		# hitTest is a STYLE property when BOUND -- directly under a (block ...) it throws at build time.
		(style
			(backgroundColor = 0x00FFFFFF)
			(bind hitTest "!isPositionLocked")
		)
		(macro TT_DRAGGABLE _fullKey="sidePref + '.position'" _isDragEnabled="!isPositionLocked")
	)

	(block
		(style
			(bind scaleX "scale")
			(bind scaleY "scale")
		)

		(block
			(style
				(hitTest = false)
			)
			(mc contrast_panel
				(class $FullsizeAbsolute)
				(bind visible "isBackgroundVisible")
				(style
					(bind alpha "backgroundAlpha")
				)
			)

			(block
				(style
					(padding = 10px)
					(bind vgap "8px + rowGap")
				)

				# Header Text
				(tf
					(class $TextDefaultBoldNM)
					(style
						(bind textColor "fontColor")
					)
					(bind text "headerText")
				)

				# Damage Rows
				(block
					(style
						(bind vgap "rowGap")
						(bind height "rowCounts * (rowGap + ADM_ROW_HEIGHT) - rowGap")
						(bind flow "isReversed ? Flow.REVERSE_VERTICAL : Flow.VERTICAL")
					)
					(controller $Repeat renderer='ADM_DamageMeterRowItem'
						(bind count "rowCounts")
						(args
							_damageLogData="damageLogs[$index]"
						)
					)
				)
			)
		)
	)

	# Mod Config
	(element TT_ConfigButtonElement _modSlug = "'ttaro.damage-meter'"
		(style
			(left = -30px)
		)
	)
)

(def element ADM_DamageMeterRowItem(_damageLogData:dict=null)
	(scope
		(var activeLog:bool = "$index == 0")
	)

	(bind visible "activeLog || _damageLogData ? true : false")
	(style
		(bind alpha "activeLog && !_damageLogData ? 0 : 1.0")
	)
	# In order for the draggable window wdith to be fixed,
	# At least one element needs to be visible, even if the damageLog is empty

	(style
		(height = "ADM_ROW_HEIGHT")
		(flow = "Flow.HORIZONTAL")
		(align = "middle|center")
		(marginLeft = 7px)
	)

	# (block
	# 	(class $FullsizeAbsolute)
	# 	(style
	# 		(backgroundColor = 0x0FFFFFFF)
	# 	)
	# )
	(element ADM_RowIndexItem _index="$index")
	(element ADM_PlayerNameAndTagItem _damageLogData="_damageLogData")
	(element ADM_ShipInfoItem _damageLogData="_damageLogData")
	(element ADM_DamageInfoItem _damageLogData="_damageLogData" _isAnimated="activeLog")
)

(def element ADM_RowIndexItem(_index:number)
	(scope
		(macro TT_GET_PREF _varName="'rowIndexPref'" _key="'ttaro.dDamageMeter.panel.showIndex'")
		(var isRowIndexVisible:bool = "null != rowIndexPref && null != rowIndexPref.value ? rowIndexPref.value : true")

		(var indexText:str = "'' + (_index + 1) + '.'")
	)

	(bind visible "isRowIndexVisible")

	(style
		(height = 100%)
		(align = "middle|center")
		(alpha = "0.6")
		(width = 22px)
	)

	(element ADM_TextItem _text="indexText" _width="100%")
)

(def element ADM_PlayerNameAndTagItem(_damageLogData:dict)
	(scope
		(macro TT_GET_PREF _varName="'clanTagPref'" _key="'ttaro.dDamageMeter.playerInfo.clan'")
		(var isClanTagVisible:bool = "null != clanTagPref && null != clanTagPref.value ? clanTagPref.value : false")
		(macro TT_GET_PREF _varName="'playerNamePref'" _key="'ttaro.dDamageMeter.playerInfo.name'")
		(var isPlayerNameVisible:bool = "null != playerNamePref && null != playerNamePref.value ? playerNamePref.value : true")
		(macro TT_GET_PREF _varName="'widthPref'" _key="'ttaro.dDamageMeter.playerInfo.width'")
		(var nameWidth:number = "widthPref.value")

		# Names
		(var playerName:str = "isPlayerNameVisible && _damageLogData ? _damageLogData.playerName : ''")

		(var clanTag:str = "_damageLogData ? _damageLogData.clanTag : ''")
		(var clanTagWithBrackets:str = "isClanTagVisible && clanTag ? '[' + clanTag + ']' : ''")

		(var nameWithTag:str = "clanTagWithBrackets + playerName")
	)

	(style
		(height = 100%)
		(align = "middle|center")
	)

	(bind visible "isClanTagVisible || isPlayerNameVisible")

	(element ADM_TextItem _text="nameWithTag" _width="nameWidth")
)

(def element ADM_ShipInfoItem(_damageLogData:dict)
	(scope
		(macro TT_GET_PREF _varName="'shipNamePref'" _key="'ttaro.dDamageMeter.shipInfo.name'")
		(var isShipNameVisible:bool = "null != shipNamePref && null != shipNamePref.value ? shipNamePref.value : true")
		(macro TT_GET_PREF _varName="'shipTypePref'" _key="'ttaro.dDamageMeter.shipInfo.icon'")
		(var isShipTypeVisible:bool = "null != shipTypePref && null != shipTypePref.value ? shipTypePref.value : true")
		(macro TT_GET_PREF _varName="'widthPref'" _key="'ttaro.dDamageMeter.shipInfo.width'")
		(var nameWidth:number = "widthPref.value")
		(macro TT_GET_PREF _varName="'shipTypeStylePref'" _key="'ttaro.dDamageMeter.shipInfo.color'")
		(var shipTypeStylePrefIndex:number = "null != shipTypeStylePref && null != shipTypeStylePref.value ? shipTypeStylePref.value : 0")

		# Names
		(var shipName:str = "_damageLogData ? tr(_damageLogData.shipNameIDS) : ''")
		(var shipType:str = "_damageLogData ? _damageLogData.subtype : ''")

		# Color
		(var shipTypeStyleIndex:number = "shipTypeStylePrefIndex < ADM_SHIP_ICON_COLOR_PRESET.length ? shipTypeStylePrefIndex : 0")
		(var shipTypeStyle:dict = "ADM_SHIP_ICON_COLOR_PRESET[shipTypeStyleIndex]")
		(var shipTypeColorTransform:dict = "shipTypeStyle[shipType]")
		(var shipIcon:str = "'url:../battle_hud/markers/ship/icon_white_' + toLower(shipType) + '.png'")
	)

	(style
		(height = 100%)
		(flow = "Flow.HORIZONTAL")
		(align = "center|middle")
	)

	# Ship Type
	(block
		(bind visible "isShipTypeVisible")
		(style
			(width = "SHIP_ICON_SIZE.WIDTH")
			(height = "SHIP_ICON_SIZE.HEIGHT")
		)
		(block
			# For better edge for colored icons
			(style
				(bind backgroundImage "shipIcon")
			)
		)
		(block
			(bind colorTransform "shipTypeColorTransform")
			(style
				(bind backgroundImage "shipIcon")
			)
		)
	)

	# Ship Name
	(element ADM_TextItem _text="shipName" _width="nameWidth"
		(bind visible "isShipNameVisible")
	)
)

(def element ADM_DamageInfoItem(_damageLogData:dict, _isAnimated:bool=false)
	(scope
		(macro TT_GET_PREF _varName="'lastDamagePref'" _key="'ttaro.dDamageMeter.panel.lastDamage'")
		(var isLastDamageVisible:bool = "null != lastDamagePref && null != lastDamagePref.value ? lastDamagePref.value : true")

		# Damages
		(var totalDamage:number = "_damageLogData ? _damageLogData.totalDamage : 0")
		(var lastDamage:number = "_damageLogData ? _damageLogData.lastDamage : 0")

		# Victim: this must be updated AFTER totalDamage
		# Otherwise it will show incorrect (previous player's) damage
		# Relying on the execution order may not be smart though
		(var victimId:number = "_damageLogData ? _damageLogData.victimId : 0")
		(event evPlayerChanged)
		(dispatch evPlayerChanged args="{}" (bind trigger "victimId"))

		(var animatedTotalDamage:number = "_isAnimated ? 0 : totalDamage" watch=false (event "evPlayerChanged"))
		(controller $Animation
			(bindcall play	duration = 0.6
							to = "{ animatedTotalDamage: totalDamage}"
							easing="Easing.cubic_out"
							(bind enabled "_isAnimated")
							(bind trigger "totalDamage")
							(event "evPlayerChanged")
			)
		)
		
		(var totalDamageText:str = "ceil(animatedTotalDamage)")
		(var lastDamageText:str = "'(+' + lastDamage")
	)

	(style
		(height = 100%)
		(flow = "Flow.HORIZONTAL")
		(align = "center|middle")
	)

	(element ADM_TextItem _text="totalDamageText" _width="50px" _textAlign="right")
	(hblock
		(style
			(align = "middle|center")
			(height = 100%)
			(alpha = "0.6")
		)
		(bind visible "isLastDamageVisible")
		
		(element ADM_TextItem _text="lastDamageText" _width="60px" _textAlign="right")
		(element ADM_AmmoIconItem _damageLogData="_damageLogData")
		(element ADM_TextItem _text="')'")
	)
)

(def element ADM_TextItem(_text:str, _width:number="'auto'", _textAlign:number = "left")
	(scope
		(macro ADM_GET_FONT_COLOR)
	)

	(style
		(bind width "_width")
	)

	(tf
		(class $ADM_TextStyle)
		(style
			(bind width "_width")
			(bind textAlign "_textAlign")
			(bind textColor "fontColor")
			(elideMode = "true")
		)
		(bind text "_text")
	)
)

(def element ADM_AmmoIconItem(_damageLogData:dict)
	(scope
		(var ammoType:str = "_damageLogData && _damageLogData.ammoType ? _damageLogData.ammoType : ''")
		(var weaponIconPath:str = "'url:../battle_hud/icon_frag/icon_frag_' + ammoType + '.png'")
	)

	(style
		(bind alpha "ammoType ? 1.0 : 0")
		(width = 21px)
		(height = 21px)
		(marginTop = "-2px")
		(backgroundSize = "fill")
		(bind backgroundImage "weaponIconPath")
	)
)

(def element ADM_ContrastPanel(_isBlur:bool=false, _intensity:number="1.0")
	(scope
		(var panelElement:str = "_isBlur ? 'ADM_ContrastPanelBlur' : 'ADM_ContrastPanelNormal'")
	)
	(class $FullsizeAbsolute)
	(style
		(hitTest = false)
	)
	(controller $Instance
		(bind renderer "panelElement")
		(args "_intensity")
	)
)

(def element ADM_ContrastPanelNormal(_alpha:number=1.0)
	(class $FullsizeAbsolute)
	(mc contrast_panel
		(class $FullsizeAbsolute)
		(bind alpha "_alpha")
	)
)

(def element ADM_ContrastPanelBlur(_blurIntensity:number=0.3)
	(class $FullsizeAbsolute)
	(element DeclareBlurLayer)
	(mc mc_blurmap_medium
		(class $FullsizeAbsolute)
		(rendererString = blurMeBaby)
		(macro ADM_BIND_BLURINTENSITY "_blurIntensity")
	)
)

(def macro ADM_BIND_BLURINTENSITY(_blurIntensity:expression="0.4")
	(controller $Animation
		(bindcall play  duration="0.0001"
						to	 = "{ blurIntensity: _blurIntensity }"
						watch=false
						init=true
						(bind trigger "_blurIntensity")
		)
	)
)
